# --- LLM provider chain -----------------------------------------------------------
# Primary provider, then automatic fallbacks (used when the primary is rate-limited / down).
# Fallback entries: 'provider' or 'provider:model' (free tiers meter quota per model).
# Options: gemini | groq | openrouter | anthropic | openai | ollama | none (fully offline planner)
LLM_PROVIDER=gemini
LLM_FALLBACK=gemini:gemini-3.8-flash,gemini:gemini-3.1-flash-lite,groq

# Gemini (primary): best at reading scanned documents; free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# Groq (fallback): open-weight models; free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Others (optional)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# --- Policy knobs ------------------------------------------------------------------
STRICT_SETTLEMENT_MATH=false   # true: settlement arithmetic errors block finalization
WARNINGS_BLOCK_FINALIZE=false  # true: any reviewer warning blocks finalization
